{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.next",
      "!**/out",
      "!**/build",
      "!**/coverage",
      "!**/dist",
      "!**/node_modules",
      "!**/next-env.d.ts",
      "!**/src/components/ui",
      "!**/src/hooks/use-mobile.ts",
      "!**/src/lib/grpc/generated",
      "!**/src/features/system/report-studio",
      "!**/public",
      "!**/.response"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "off",
        "noStaticOnlyClass": "warn",
        "useLiteralKeys": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@/features/auth/components": "Deep feature imports are forbidden. Import from '@/features/auth' public barrel instead.",
              "@/features/docs/components": "Deep feature imports are forbidden. Import from '@/features/docs' public barrel instead.",
              "@/features/screens/forms/components": "Deep feature imports are forbidden. Import from '@/features/screens' public barrel instead.",
              "@/features/screens/enquiries/components": "Deep feature imports are forbidden. Import from '@/features/screens' public barrel instead.",
              "@/features/settings/components": "Deep feature imports are forbidden. Import from '@/features/settings' public barrel instead."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
