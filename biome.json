{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.css",
      "!**/src/components/ui",
      "!**/src/hooks/use-mobile.ts",
      "!**/src/lib/infra-grpc/generated",
      "!**/mock/db/.rawResponse"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/types/**", "src/lib/data-schemas/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/**",
                      "!@/types",
                      "!@/types/**",
                      "!@/lib/data-schemas",
                      "!@/lib/data-schemas/**"
                    ],
                    "message": "L0 contracts (types, data-schemas) may only import other L0 modules. See .agents/rules/01-architecture-layers.md / pnpm verify:layers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/core-config/**",
        "src/lib/core-logger/**",
        "src/lib/data-parsers/**",
        "src/lib/infra-*/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/lib/cbs-*",
                      "@/lib/cbs-*/**",
                      "@/lib/core-utils",
                      "@/lib/core-utils/**",
                      "@/store",
                      "@/store/**",
                      "@/hooks",
                      "@/hooks/**",
                      "@/components/**",
                      "@/features/**",
                      "@/app/**"
                    ],
                    "message": "L1 core/infra may only import L0–L1. Notify upward via the adapter bus. See .agents/rules/01-architecture-layers.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/cbs-*/**", "src/lib/core-utils/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/store",
                      "@/store/**",
                      "@/hooks",
                      "@/hooks/**",
                      "@/components/**",
                      "@/features/**",
                      "@/app/**"
                    ],
                    "message": "src/lib must never import store/hooks/components/features/app. Use notifyUser() / registerCommandAdapter (adapter bus). See .agents/rules/01-architecture-layers.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/store/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/hooks",
                      "@/hooks/**",
                      "@/components/**",
                      "@/features/**",
                      "@/app/**"
                    ],
                    "message": "L3 store may only import L0–L3. See .agents/rules/01-architecture-layers.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/components/**", "@/features/**", "@/app/**"],
                    "message": "L3.5 hooks may only import L0–L3.5. See .agents/rules/01-architecture-layers.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "@/app/**",
                      "!@/app/**/*.png",
                      "!@/app/**/*.svg",
                      "!@/app/**/*.ico"
                    ],
                    "message": "L4 components may not import features or app code (static assets excepted). See .agents/rules/01-architecture-layers.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/core-logger/**", "scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/store/theme/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    }
  ]
}
