# ==============================================================================
# FinXUI Core Banking Workbench - Canonical Environment Template
# Copy this file to `.env.local` for local development overrides.
#
# Two independent switches (any combination is valid):
#
#   DATA_SOURCE    static = in-memory mock core (mock/), no network
#                  grpc   = live Java core at GRPC_HOST
#   CACHE_ENABLED  false  = no Redis: sessions and login rate limits in server memory, no spec cache
#                  true   = Redis at REDIS_URL for sessions, rate limits and the spec cache.
#                           If Redis is down, the app keeps working on server memory and
#                           switches back to Redis automatically when it returns.
#
# Production: DATA_SOURCE=grpc + CACHE_ENABLED=true (sessions must survive restarts and be shared
# across instances). With the mock + cache on, run `pnpm cache:clear` after editing mock/db specs.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & RUNTIME MODE
# ==============================================================================
# Server execution environment: development | production | test
NODE_ENV=development

# Logging verbosity: 'debug' | 'info' | 'warn' | 'error' (Set 'warn' or 'error' to silence terminal)
LOG_LEVEL=info

# Unified Data Source — controls ALL backend connections:
# forms, menus, inquiries, branches, and login authentication.
# Values: grpc | static
DATA_SOURCE=static

# ==============================================================================
# 2. SECURITY & AUTHENTICATION
# ==============================================================================
# Max consecutive login failures before rate limiting
LOGIN_LIMIT=10

# Whether to enforce HTTPS channel
USE_HTTPS=false

# ==============================================================================
# 3. CORE BANKING ENGINE (gRPC)
# ==============================================================================
# Target gRPC server endpoint (e.g. 172.18.18.66:50055)
GRPC_HOST=localhost:9090

# Enable gRPC TLS/SSL Encryption: true | false
GRPC_USE_TLS=false

# gRPC request timeout deadline in milliseconds
GRPC_TIMEOUT_MS=8000

# Transaction type codes routed as financial transactions (comma-separated)
GRPC_FINANCIAL_TRANSACTION_TYPES=ATT,CTT,AFT

# Client / Channel Identifier for gRPC requests (e.g., WEB-CLIENT, CBS_WEB)
CLIENT_ID=WEB-CLIENT

# ==============================================================================
# 4. MICROSERVICES: SERVICE_<NAME>_URL
# ==============================================================================
# NAME = jar name = the DB servicePath (letters and digits, any case). One line per service.
# The core is servicePath "default" and always uses GRPC_HOST (SERVICE_DEFAULT_URL is rejected).
# The address picks the protocol:
#   host:port                     -> gRPC (same contract as the core)
#   http(s)://host:port/endpoint  -> REST: the same flat request, POSTed as JSON to that exact URL
#                                    with the core login token (Authorization: Bearer)
# A request for a service with no line here fails with 503; it is never sent to the core.
# Any other SERVICE_* variable stops start-up, so a misspelled name can't misroute quietly.
SERVICE_FINXURM_URL=http://localhost:8282/finxurm/inq

# ==============================================================================
# 5. CACHING LAYER (Redis)
# ==============================================================================
# Redis Server Connection URI
REDIS_URL=redis://127.0.0.1:6379

# Key Namespace Prefix for Redis Keys
REDIS_KEY_PREFIX=cbs

# Master Cache Toggle (true | false)
CACHE_ENABLED=false

# Circuit breaker cooldown period in milliseconds upon Redis error
CACHE_COOLDOWN_MS=5000

# Cache TTL for Navigation Menus in seconds (default 600)
MENU_TTL_SECONDS=600

# Cache TTL for Screen Specifications/GMC Models in seconds (default 3600)
SPEC_TTL_SECONDS=3600

# Secret for DELETE /api/cache (header x-cache-token). Empty = endpoint disabled.
# To enable, set a long random value (for example `openssl rand -hex 32`); never commit it.
CACHE_INVALIDATE_TOKEN=

# ==============================================================================
# 6. CLIENT-EXPOSED CONFIG (Next.js Public Bundle)
# ==============================================================================
# Default Central Bank Branch Code
NEXT_PUBLIC_CENTRAL_BRANCH=JB9999

# User Inactivity Logout Timeout (in minutes)
NEXT_PUBLIC_LOGOUT_TIME=60
