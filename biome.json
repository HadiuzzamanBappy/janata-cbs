{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.next",
      "!**/out",
      "!**/build",
      "!**/coverage",
      "!**/dist",
      "!**/node_modules",
      "!**/*.css",
      "!**/next-env.d.ts",
      "!**/src/components/ui",
      "!**/src/hooks/use-mobile.ts",
      "!**/src/lib/infra-grpc/generated",
      "!**/public",
      "!**/.response"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off",
        "noDocumentCookie": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@/features/auth/components": "Import from '@/features/auth' public barrel instead.",
              "@/features/command/components": "Import from '@/features/command' public barrel instead.",
              "@/features/docs/components": "Import from '@/features/docs' public barrel instead.",
              "@/features/operations/components": "Import from '@/features/operations' public barrel instead.",
              "@/features/settings/components": "Import from '@/features/settings' public barrel instead.",
              "@/features/system/components": "Import from '@/features/system' public barrel instead.",
              "@/features/workbench/components": "Import from '@/features/workbench' public barrel instead."
            }
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  }
}
