# ==============================================================================
# FinXUI Core Banking Workbench - Canonical Environment Template
# Copy this file to `.env.local` for local development overrides.
#
# QUICK PRESETS (Toggle lines in `.env.local`):
#
# [PRESET A: Offline Mock Mode (Zero dependencies, instant local boot)]
#   MODEL_SOURCE=static
#   USER_SOURCE=static
#   CACHE_ENABLED=false
#
# [PRESET B: Live gRPC & Redis Mode (Enterprise connected)]
#   MODEL_SOURCE=grpc
#   USER_SOURCE=grpc
#   CACHE_ENABLED=true
#   GRPC_HOST=172.18.18.66:50055
#   REDIS_URL=redis://127.0.0.1:6379
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & RUNTIME MODE
# ==============================================================================
# Server execution environment: development | production | test
NODE_ENV=development

# Logging verbosity: 'debug' | 'info' | 'warn' | 'error' (Set 'warn' or 'error' to silence terminal)
LOG_LEVEL=info

# Core Banking Schema / Model Source: grpc | static
MODEL_SOURCE=static

# User Authentication Source: grpc | static
USER_SOURCE=static

# ==============================================================================
# 2. SECURITY & AUTHENTICATION
# ==============================================================================
# Max consecutive login failures before rate limiting
LOGIN_LIMIT=10

# Whether to enforce HTTPS channel
USE_HTTPS=false

# ==============================================================================
# 3. CORE BANKING ENGINE (gRPC)
# ==============================================================================
# Target gRPC server endpoint (e.g. 172.18.18.66:50055)
GRPC_HOST=localhost:9090

# Enable gRPC TLS/SSL Encryption: true | false
GRPC_USE_TLS=false

# gRPC request timeout deadline in milliseconds
GRPC_TIMEOUT_MS=8000

# Transaction type codes routed as financial transactions (comma-separated)
GRPC_FINANCIAL_TRANSACTION_TYPES=AFT,ACT

# Client / Channel Identifier for gRPC requests (e.g., WEB-CLIENT, CBS_WEB)
CLIENT_ID=WEB-CLIENT

# ==============================================================================
# 4. DOWNSTREAM MICROSERVICES (HTTP / REST)
# ==============================================================================
# Customer Microservice Base URL (e.g. http://localhost:8383 or internal docker/k8s dns)
SERVICE_CUSTOMER_BASE_URL=http://localhost:8383

# User Role Management (URM) Microservice Base URL (e.g. http://localhost:8282 or internal docker/k8s dns)
SERVICE_URM_BASE_URL=http://localhost:8282

# ==============================================================================
# 5. CACHING LAYER (Redis)
# ==============================================================================
# Redis Server Connection URI
REDIS_URL=redis://127.0.0.1:6379

# Key Namespace Prefix for Redis Keys
REDIS_KEY_PREFIX=cbs

# Master Cache Toggle (true | false)
CACHE_ENABLED=false

# Circuit breaker cooldown period in milliseconds upon Redis error
CACHE_COOLDOWN_MS=5000

# Cache TTL for Navigation Menus in seconds (default 600)
MENU_TTL_SECONDS=600

# Cache TTL for Screen Specifications/GMC Models in seconds (default 3600)
SPEC_TTL_SECONDS=3600

# Auth Secret for Cache Invalidation Endpoint (POST /api/cache)
CACHE_INVALIDATE_TOKEN=super-secret-cache-token

# ==============================================================================
# 6. CLIENT-EXPOSED CONFIG (Next.js Public Bundle)
# ==============================================================================
# Default Central Bank Branch Code
NEXT_PUBLIC_CENTRAL_BRANCH=JB9999

# User Inactivity Logout Timeout (in minutes)
NEXT_PUBLIC_LOGOUT_TIME=60
